+def foreign_rows(jobs_file, expected_fp):
+    """W2-C067: строки jobs.jsonl чужой постановки — ключ вне плана или другой отпечаток.
+    Повреждённая (недописанная) строка — не чужая: допустима при продолжении после сбоя."""
+    mismatched, unknown, corrupt = 0, 0, 0
+    if not jobs_file.exists():
+        return dict(mismatched=0, unknown=0, corrupt=0)
+    for line in jobs_file.read_text(encoding='utf-8').splitlines():
+        if not line.strip():
+            continue
+        try:
+            row = json.loads(line)
+            key = (row['orbit_id'], float(row['years']), row['variant'])
+        except (ValueError, KeyError, TypeError):
+            corrupt += 1
+            continue
+        if key not in expected_fp:
+            unknown += 1
+        elif row.get('job_fingerprint') != expected_fp[key]:
+            mismatched += 1
+    return dict(mismatched=mismatched, unknown=unknown, corrupt=corrupt)
+
+
+def units_document(unit_list, params):
