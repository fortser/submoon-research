+                        'продолжение и разбор этого каталога текущим стендом запрещены — новый --run-dir')
+    accepted = sorted(p.name for p in run_dir.glob('acceptance*.json'))
+    if accepted and out_dir == run_dir:
+        problems.append(f"run уже принят ({', '.join(accepted)}); новый разбор — только в отдельный --analysis-dir")
+    stored = run_dir/'units.json'
+    if stored.exists():
+        try:
+            digest = json.loads(stored.read_text(encoding='utf-8')).get('units_sha256')
+        except ValueError:
