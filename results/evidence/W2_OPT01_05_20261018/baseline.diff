+    return dict(plan=PLAN, stage=STAGE, generator_numerics=NUMERICS_VERSION, params=params,
+                units_sha256=units_digest(unit_list), units=unit_list)
+
+
+def guard_run_dir(run_dir, out_dir, foreign, unit_list):
