{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research journal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "revision",
    "utc",
    "actor",
    "record"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "utc": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "description": "Детерминированный ID события (S0-T006): повтор той же записи не создаёт дубля; отсутствует у событий до 2026-10-13."
    },
    "record": {
      "$ref": "record.schema.json"
    }
  }
}
