{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research tracking record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "status",
    "summary",
    "refs",
    "next_action",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z][A-Z0-9_-]*$"
    },
    "kind": {
      "enum": [
        "stage",
        "task",
        "decision",
        "check",
        "result",
        "issue",
        "hypothesis",
        "plan"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "detail_path": {
      "type": "string"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_runs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stage"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "blocked",
              "complete",
              "planned",
              "ready"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "blocked",
              "cancelled",
              "done",
              "planned",
              "ready"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "proposed",
              "rejected",
              "superseded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "inconclusive",
              "passed",
              "planned"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "preliminary",
              "rejected",
              "superseded",
              "validated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "dismissed",
              "fixed",
              "investigating",
              "open",
              "verified"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hypothesis"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "contradicted",
              "inconclusive",
              "proposed",
              "supported",
              "testing"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "completed",
              "proposed",
              "superseded"
            ]
          }
        }
      }
    }
  ]
}
